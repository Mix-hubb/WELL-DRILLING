PORT=4000

# Supabase Session Pooler connection string (preferred for Render)
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Use these only when DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=postgres
DB_SSL=false
DB_FORCE_IPV4=false

# ที่อยู่ frontend ที่อนุญาตให้เรียก API (CORS)
CORS_ORIGIN=http://localhost:5173

# JWT secret key (เปลี่ยนใน production)
JWT_SECRET=your-secret-key-change-this

# Backend public URL (used in LINE messages for LIFF fallback)
APP_URL=https://your-backend.onrender.com

# LINE Messaging API (เก็บไว้ reference — ค่าจริงเก็บในตาราง organizations)
# LINE_CHANNEL_SECRET=your-channel-secret
# LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
# LINE_LIFF_ID_DRILLING=@liff/xxxxx
# LINE_LIFF_ID_REPAIR=@liff/xxxxx

# SMTP (สำหรับส่งอีเมลรีเซ็ตรหัสผ่าน)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# SMTP_FROM=your-email@example.com

# Twilio SMS (สำหรับส่ง SMS รีเซ็ตรหัสผ่าน)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
